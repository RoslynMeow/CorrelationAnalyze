{
  "name": "association-analyzer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "纯前端 CSV 关联性分析看板",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:single": "vue-tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "i18n:catalog": "node scripts/i18n-catalog.mjs"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "plotly.js-dist-min": "^4.3.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
